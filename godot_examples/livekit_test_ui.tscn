[node name="RoomEdit" type="LineEdit" parent="./VBoxContainer"]
placeholder_text = "Room name"

[node name="ConnectButton" type="Button" parent="./VBoxContainer"]
text = "Request Token & Connect"

[node name="StatusLabel" type="Label" parent="./VBoxContainer"]
text = "Status: idle"

[node name="TokenLabel" type="Label" parent="./VBoxContainer"]
text = "Token: (none)"

