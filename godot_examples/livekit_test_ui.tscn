[gd_scene load_steps=3 format=3 uid="uid://livekit_test_ui_scene"]
[node name="LiveKitTestUI" type="Control"]
script = ExtResource( 1 )

[node name="VBoxContainer" type="VBoxContainer" parent="."]
margin_left = 24
margin_top = 24
margin_right = 24
margin_bottom = 24
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="BackendEdit" type="LineEdit" parent="./VBoxContainer"]
